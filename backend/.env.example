# Application Configuration
PROJECT_NAME="Accessory Inventory API"
VERSION="0.1.0"
API_V1_STR="/api"

# CORS Configuration (JSON array of allowed origins)
ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=

# Supabase Auth / JWT Configuration
# With the project's JWT signing keys (recommended): set only SUPABASE_URL
# below. ES256 signatures are verified against the keys published at
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json (override via SUPABASE_JWKS_URL
# only if you publish keys elsewhere). SUPABASE_URL also validates the issuer
# claim (iss = https://<project-ref>.supabase.co/auth/v1).
#
# Legacy HS256 (optional): if SUPABASE_JWT_SECRET is set (the project's legacy
# "JWT Secret" from Project Settings -> API), HS256 tokens are also accepted.
# Leave it empty to disable the legacy path — ES256 verification still works.
ADMIN_EMAILS=["admin@example.com"]   # JSON array format; listed emails are administrators
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE="authenticated"
# SUPABASE_JWKS_URL=

# Supabase Storage Configuration
SUPABASE_URL=https://odxdlzjneljsviuavqtn.supabase.co
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
